<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nexus — Beta Access</title>
<style>
  :root{
    --bg:#07080b;--panel:#0e1117;--line:#1c2330;
    --ink:#e8ecf3;--muted:#7b8699;--accent:#7c5cff;--accent-2:#00e0b8;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Inter',system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6;min-height:100vh}
  body::before{content:"";position:fixed;inset:0;z-index:-1;background:radial-gradient(circle at 15% 10%, rgba(124,92,255,.18), transparent 45%),radial-gradient(circle at 85% 90%, rgba(0,224,184,.12), transparent 45%)}
  .wrap{max-width:760px;margin:0 auto;padding:0 22px}
  header{position:sticky;top:0;z-index:60;background:rgba(7,8,11,.78);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
  nav{display:flex;align-items:center;justify-content:space-between;padding:16px 0}
  .logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:1.2rem;letter-spacing:-.02em}
  .logo-mark{width:30px;height:30px;border-radius:8px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:grid;place-items:center;font-size:.9rem;font-weight:900;color:#07080b}
  .logo span{background:linear-gradient(90deg,var(--accent),var(--accent-2));-webkit-background-clip:text;background-clip:text;color:transparent}
  .hero{padding:72px 0 40px;text-align:center}
  .badge{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:999px;border:1px solid var(--line);background:var(--panel);font-size:.78rem;color:var(--muted);margin-bottom:22px}
  .badge .dot{width:7px;height:7px;border-radius:50%;background:var(--accent-2);box-shadow:0 0 10px var(--accent-2)}
  .hero h1{font-size:clamp(2rem,5vw,3rem);line-height:1.08;letter-spacing:-.035em;margin-bottom:16px}
  .hero h1 em{font-style:normal;background:linear-gradient(90deg,var(--accent),var(--accent-2));-webkit-background-clip:text;background-clip:text;color:transparent}
  .hero p{color:var(--muted);max-width:46ch;margin:0 auto;font-size:1rem}
  .product{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:32px;margin:36px 0 60px;text-align:center}
  .product-icon{width:56px;height:56px;border-radius:14px;margin:0 auto 18px;display:grid;place-items:center;background:rgba(124,92,255,.12);border:1px solid rgba(124,92,255,.3);font-size:1.5rem}
  .product h2{font-size:1.5rem;letter-spacing:-.02em;margin-bottom:6px}
  .product .price{font-size:2rem;font-weight:800;letter-spacing:-.03em;margin:18px 0 24px}
  .product .price span{font-size:.85rem;color:var(--muted);font-weight:500}
  .btn{padding:13px 26px;border-radius:999px;border:none;cursor:pointer;font:inherit;font-weight:700;font-size:.9rem;transition:all .2s;display:inline-flex;align-items:center;justify-content:center;gap:7px;text-decoration:none}
  .btn-primary{background:linear-gradient(135deg,var(--accent),#5a3fe0);color:#fff;box-shadow:0 8px 22px -10px var(--accent);width:100%}
  .btn-primary:hover{transform:translateY(-1px);opacity:.95}
  .trust{margin-top:18px;font-size:.75rem;color:var(--muted);display:flex;justify-content:center;gap:14px;flex-wrap:wrap}
  .trust span{display:inline-flex;align-items:center;gap:5px}
  footer{padding:40px 0 60px;border-top:1px solid var(--line);margin-top:20px;color:var(--muted);font-size:.82rem;text-align:center}
</style>
</head>
<body>

<header>
  <div class="wrap">
    <nav>
      <div class="logo"><div class="logo-mark">N</div>Nexus<span>.</span></div>
    </nav>
  </div>
</header>

<main>
  <div class="wrap">
    <section class="hero">
      <div class="badge"><span class="dot"></span>Beta access — $5 flat</div>
      <h1>Get <em>Nexus Beta</em>.<br>Delivered instantly.</h1>
      <p>Pay $5 securely via PayPal — your unique key is delivered right after checkout.</p>
    </section>

    <section class="product">
      <div class="product-icon">⚡</div>
      <h2>Nexus Beta</h2>
      <div class="price">$5 <span>USD</span></div>
      <button class="btn btn-primary" id="buyBtn" type="button">Buy Nexus Beta →</button>
      <div class="trust">
        <span>🔒 Secure PayPal checkout</span>
        <span>📩 Instant delivery</span>
        <span>🔑 One unique key per order</span>
      </div>
    </section>
  </div>
</main>

<footer>
  <div class="wrap">© 2026 Nexus. All rights reserved.</div>
</footer>

<script>
  document.getElementById('buyBtn').addEventListener('click', function () {
    window.location.href = 'https://payhip.com/b/vsqzb';
  });
</script>

</body>
</html>
